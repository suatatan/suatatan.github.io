---
layout: null
sitemap:
  exclude: 'yes'
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}
    {% assign page_robots = page.robots | default: '' %}
    {% unless page.sitemap == false or page.sitemap.exclude == "yes" or page_robots contains "noindex" or page.redirect_to or page.name == "404.html" or page.name == "sitemap.xml" %}
      <url>
        <loc>{{ page.url | absolute_url }}</loc>
        {% if page.date %}
          <lastmod>{{ page.date | date_to_xmlschema }}</lastmod>
        {% endif %}
      </url>
    {% endunless %}
  {% endfor %}
  {% for post in site.posts %}
    {% assign post_robots = post.robots | default: '' %}
    {% unless post.sitemap == false or post.sitemap.exclude == "yes" or post_robots contains "noindex" or post.redirect_to %}
      <url>
        <loc>{{ post.url | absolute_url }}</loc>
        <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
      </url>
    {% endunless %}
  {% endfor %}
</urlset>
